{
  "identifier": "desktop-pilot",
  "local": true,
  "platforms": [
    "macOS"
  ],
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-open-managed-vault",
    "allow-unlock-managed-vault",
    "allow-lock-managed-vault",
    "allow-begin-vault-setup",
    "allow-get-vault-setup-state",
    "allow-get-setup-recovery-code",
    "allow-confirm-vault-setup",
    "allow-cancel-vault-setup",
    "allow-open-synthetic-session",
    "allow-get-session-state",
    "allow-lock-vault",
    "allow-list-credentials",
    "allow-get-credential-details",
    "allow-reveal-credential-password",
    "allow-create-credential",
    "allow-update-credential",
    "allow-delete-credential",
    "allow-get-credential-operation",
    "allow-set-desktop-dirty",
    "allow-resolve-desktop-close",
    "allow-record-desktop-activity"
  ]
}
